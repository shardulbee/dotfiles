{
  "manifest_version": 3,
  "name": "Alt Click New Tab",
  "version": "1.0",
  "description": "Treat Alt+click on links like Cmd/Ctrl+click: open in a new background tab instead of downloading.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
