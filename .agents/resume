#!/usr/bin/env bash
set -euo pipefail

sudo systemctl start tailscaled

nix_profile="$HOME/.nix-profile"
if [[ -f "$nix_profile/etc/profile.d/nix.sh" ]]; then
  # shellcheck disable=SC1091
  source "$nix_profile/etc/profile.d/nix.sh"
fi

if [[ -n "${ATTIC_TOKEN:-}" ]]; then
  : "${TAILSCALE_CLIENT_ID:?Set TAILSCALE_CLIENT_ID}"
  : "${TAILSCALE_AUDIENCE:?Set TAILSCALE_AUDIENCE}"

  if ! tailscale status --json | jq -e '.BackendState == "Running"' >/dev/null; then
    identity_token="$(amp orb id-token \
      --audience "$TAILSCALE_AUDIENCE" \
      --subject-scope project)"
    orb_name="${AMP_THREAD_ID:-$(hostname)}"
    orb_name="${orb_name:0:40}"
    sudo tailscale up \
      --client-id="${TAILSCALE_CLIENT_ID}?ephemeral=true&preauthorized=true" \
      --id-token="$identity_token" \
      --advertise-tags=tag:amp-dotfiles-deploy \
      --hostname="amp-dotfiles-$orb_name"
    unset identity_token
  fi

  attic login --set-default sharbox http://sharbox:8081 "$ATTIC_TOKEN"
  attic use sharbox:turbochardo
  printf '%s\n' 'Configured private Attic cache turbochardo.'
else
  printf '%s\n' 'Attic is not configured; Nix builds will use their default substituters.'
fi
