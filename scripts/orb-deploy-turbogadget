set -euo pipefail

# Run from the dotfiles Amp project's orb, not a personal host.
# Requires its TAILSCALE_CLIENT_ID, TAILSCALE_AUDIENCE and SHARCHY_DEPLOY_SSH_KEY.
# Bootstrap once locally: see config/turbogadget-deploy.nix. Then no password prompt.
# Connects through an ephemeral tag:amp-dotfiles-deploy node using standard SSH.
# Host independently fetches current GitHub main; no uploaded code or shell access.
# Host build/activation and failure semantics: deploy-turbogadget-host.py.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
if [[ -n "$(git status --porcelain)" ]]; then
  echo 'Dotfiles working tree must be clean before deployment.' >&2
  exit 1
fi
revision="$(git rev-parse HEAD)"
remote_revision="$(git ls-remote origin refs/heads/main | cut -f1)"
if [[ "$revision" != "$remote_revision" ]]; then
  echo 'Dotfiles HEAD must be pushed to origin/main before deployment.' >&2
  exit 1
fi

: "${TAILSCALE_CLIENT_ID:?Set TAILSCALE_CLIENT_ID}"
: "${TAILSCALE_AUDIENCE:?Set TAILSCALE_AUDIENCE}"
# Reuse the dotfiles project's existing deployment key; never copy a host key.
: "${SHARCHY_DEPLOY_SSH_KEY:?Set the existing dotfiles deployment key}"

key_file="$(mktemp)"
joined=0
cleanup() {
  rm -f "$key_file"
  if [[ "$joined" == 1 ]]; then
    sudo tailscale logout >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
chmod 600 "$key_file"
printf '%s\n' "$SHARCHY_DEPLOY_SSH_KEY" > "$key_file"
unset SHARCHY_DEPLOY_SSH_KEY

token="$(amp orb id-token --audience "$TAILSCALE_AUDIENCE" --subject-scope project)"
orb_name="${AMP_THREAD_ID:-$(hostname)}"
orb_name="${orb_name:0:40}"
sudo tailscale up \
  --client-id="${TAILSCALE_CLIENT_ID}?ephemeral=true&preauthorized=true" \
  --id-token="$token" \
  --advertise-tags=tag:amp-dotfiles-deploy \
  --hostname="amp-dotfiles-deploy-$orb_name"
joined=1
unset token

ssh -i "$key_file" -o BatchMode=yes -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=accept-new \
  dotfiles-deploy@turbogadget "deploy $revision"
